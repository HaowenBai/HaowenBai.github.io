source "https://rubygems.org"

# Only used for local preview. GitHub Pages builds the live site with its own
# pinned versions of the same gems, so this file does not change the live site.
#
#     bundle install                            # once
#     bundle exec jekyll serve --livereload     # preview at http://localhost:4000

gem "github-pages", group: :jekyll_plugins
gem "webrick"   # `jekyll serve` needs it on Ruby >= 3.0

gem "wdm", "~> 0.1.0" if Gem.win_platform?
